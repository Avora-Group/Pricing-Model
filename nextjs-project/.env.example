# .env.example — env-var manifest for acmi-app's frontend (Next.js, on Vercel).
#
# Names only — NO real secret values committed here. Copy to .env.local and
# fill in real values for local dev; set the same names on the Vercel project
# "pricing-model" (Project Settings -> Environment Variables). Vercel binds
# variables at deploy time, so every change there needs a redeploy.
#
# A blank `NAME=` line does not leave a variable unset: it sets it to "".
# Variables with a code default are therefore commented out below; uncomment
# one only to override its default.

# ── API ──────────────────────────────────────────────────────────────────────

# API_URL — base URL of the FastAPI backend, read on the server by the
# dashboard pages, the server actions and the Azure callback route.
# Server-only. Leave this line commented out to use the code default
# http://localhost:8000 (a blank `API_URL=` sets it to "" and breaks every
# server-side fetch).
# API_URL=http://localhost:8000

# NEXT_PUBLIC_API_URL — the same backend as the browser reaches it, read by
# src/lib/api.ts. Ships in the browser bundle; not a secret. Leave this line
# commented out to use the code default http://localhost:8000 (a blank
# `NEXT_PUBLIC_API_URL=` sets it to "" and sends browser fetches to the Next
# origin).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Azure sign-in ────────────────────────────────────────────────────────────

# AZURE_TENANT_ID — Entra tenant (directory) id, read by both sign-in routes
# under src/app/api/auth/. Server-only.
AZURE_TENANT_ID=

# AZURE_CLIENT_ID — client (application) id of ACMI's own Entra app
# registration. Server-only.
AZURE_CLIENT_ID=

# AZURE_CLIENT_SECRET — client secret of that registration, used by the code
# exchange in the callback route. A secret: server-only, never NEXT_PUBLIC_,
# never committed.
AZURE_CLIENT_SECRET=

# AZURE_REDIRECT_URI — redirect URI both sign-in routes send to Entra. It must
# equal the one registered for the app; the callback route is
# /api/auth/callback/azure. Server-only.
AZURE_REDIRECT_URI=

# ── Tracker request embed ────────────────────────────────────────────────────

# TRACKER_API_SCOPE — Entra scope that POST /api/tracker/token redeems the
# signed-in user's refresh token for. Server-only: the route reads it, the
# browser never talks to Entra. Not a secret, but never NEXT_PUBLIC_. It holds
# the tracker's client id, not ACMI's.
# Value: api://86fcee80-55d8-4992-937e-af37620ed7f9/access_as_user
TRACKER_API_SCOPE=

# TRACKER_RT_KEY — key that encrypts the tracker_rt cookie, which holds the
# signed-in user's Entra refresh token. A secret: server-only, never
# NEXT_PUBLIC_, never committed. 32 random bytes, base64url. Generate with:
#   node -p "require('crypto').randomBytes(32).toString('base64url')"
TRACKER_RT_KEY=

# NEXT_PUBLIC_TRACKER_API_URL — tracker API base URL the request dialog posts
# to. Leave it blank to hide both triggers (Request a feature / Report a bug).
# Requests are pinned to the tracker project "acmi-app". Ships in the browser
# bundle; not a secret.
# Value: https://task-tracker-production-a300.up.railway.app
NEXT_PUBLIC_TRACKER_API_URL=

# NEXT_PUBLIC_TRACKER_URL — tracker frontend, used for the link in the notice
# shown after a request is filed. Ships in the browser bundle; not a secret.
# Value: https://dev-tracker.avora.aero
NEXT_PUBLIC_TRACKER_URL=

# ── Build-only ───────────────────────────────────────────────────────────────

# TRACKER_REPO_TOKEN — Vercel build/install only, read by vercel-install.sh.
# A read-only fine-grained PAT (Contents: read-only) on the private
# Avora-Group/tracker-client repo, shared across the Avora apps. NEVER rename
# it to NEXT_PUBLIC_*: that prefix would inline the credential into the client
# bundle served to every visitor. Set it on Production AND Preview; without it
# vercel-install.sh fails the build on purpose. Never commit its value here.
TRACKER_REPO_TOKEN=
